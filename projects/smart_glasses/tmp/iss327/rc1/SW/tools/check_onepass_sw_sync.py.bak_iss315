_CACHE = {}


def sh(cmd, timeout=900):
    key = " ".join(cmd)
    if key in _CACHE:
        return _CACHE[key]
    try:
        r = subprocess.run(cmd, cwd=PROJ, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=timeout)
        out = (r.stdout or b"").decode("utf-8", "replace")
        rc = r.returncode
    except Exception as e:                                   # pragma: no cover
        out, rc = "EXC: %s" % e, -1
    _CACHE[key] = (rc, out)
    return rc, out


def md5(path):
    import hashlib
    h = hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def read_text(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def load_items(checklist_path):
    """★从清单页里抽 JSON 块 ⇒ (items, 全文) ★"""
    txt = read_text(checklist_path)
    m = re.search(r"```json\s*(\{.*?\})\s*```", txt, re.S)
    if not m:
        return None, txt
    try:
        data = json.loads(m.group(1))
    except Exception:
        return None, txt
    items = data.get("items")
    return (items if isinstance(items, list) else None), txt


# ==============================================================================
# 六条判据
# ==============================================================================
def check_W1(items):
    ok, bad = True, []
    if items is None:
        return False, ["     ❌ 清单页里找不到可解析的 JSON 块 (或 items 不是数组)"]
    for it in items:
        if not isinstance(it, dict):
            bad.append("item 不是 dict: %r" % (it,))
            ok = False
            continue
        miss = [f for f in FIELDS if f not in it]
        empty = [f for f in FIELDS if f in it and not str(it[f]).strip()]
        if miss or empty:
            ok = False
            bad.append("id=%s 缺字段=%s 空字段=%s" % (it.get("id", "?"), miss, empty))
    return ok, ["     条目 %d 条 · 9 字段齐全且非空: %s" % (len(items), "✔" if ok else "❌")] + \
        ["     ❌ %s" % b for b in bad]


def check_W2(items):
    ok, bad = True, []
    if items is None:
        return False, ["     ❌ 没有 items"]
    dist = {s: 0 for s in STEPS}
    for it in items:
        st = str(it.get("step", "")).strip()
        if st not in STEPS:
            ok = False
            bad.append("id=%s 的 step=%r 不在 S1~S13 (★不许写 S0 / TBD / 空★)" % (it.get("id"), st))
        else:
            dist[st] += 1
    return ok, ["     归属步分布: %s" % (" ".join("%s=%d" % (s, dist[s]) for s in STEPS) or "-")] + \
        ["     ❌ %s" % b for b in bad]


def check_W3(items):
    ok, bad = True, []
    if items is None:
        return False, ["     ❌ 没有 items"]
    for it in items:
        crit = str(it.get("criterion", ""))
        if not re.search(r"(python3|bash|md5sum|grep)\s", crit):
            ok = False
            bad.append("id=%s 的 criterion 里认不出命令: %r" % (it.get("id"), crit[:70]))
            continue
        for tok in re.findall(r"[\w./\-]+\.(?:py|sh)", crit):
            p = tok if os.path.isabs(tok) else os.path.join(PROJ, tok)
            if not os.path.exists(p):
                ok = False
                bad.append("id=%s 的 criterion 引用了不存在的文件: %s" % (it.get("id"), tok))
    return ok, ["     每条 criterion 的脚本文件都在盘上: %s" % ("✔" if ok else "❌")] + \
        ["     ❌ %s" % b for b in bad]


def check_W4(items, txt):
    ok, bad = True, []
    if items is None:
        return False, ["     ❌ 没有 items"]
    blob = json.dumps(items, ensure_ascii=False)
    ids = [str(it.get("id", "")) for it in items if isinstance(it, dict)]
    for rid in REQUIRED_IDS:
        if rid not in ids:
            ok = False
            bad.append("★清单里没有 %s ⇒ 漏项 (★①~⑧ 八条一条都不许漏★)" % rid)
    for it in items:
        if not isinstance(it, dict):
            continue
        s = str(it.get("source_iss", "")).strip()
        for tok in [x.strip() for x in s.split("+") if x.strip()]:
            if tok not in SOURCES:
                ok = False
                bad.append("id=%s 的 source_iss=%r 不在来源单全集里 ⇒ 来源不明"
                           % (it.get("id"), tok))
    return ok, ["     覆盖度: ①~⑧ 八条全部在清单里: %s" % ("✔" if ok else "❌")] + \
        ["     ❌ %s" % b for b in bad]


def check_W5(items):
    ok, bad = True, []
    if items is None:
        return False, ["     ❌ 没有 items"]
    by_id = {str(it.get("id")): it for it in items if isinstance(it, dict)}
    for item_id, (cmd, rx) in PROBES.items():
        it = by_id.get(item_id)
        if it is None:
            ok = False
            bad.append("清单里没有探针绑定的条目 %s" % item_id)
            continue
        rc, out = sh(cmd)
        m = re.search(rx, out)
        if not m:
            ok = False
            bad.append("%s 的探针没抽到值 (rc=%d): %s" % (item_id, rc, rx))
            continue
        val = m.group(1)
        state = str(it.get("current_state", ""))
        if val not in state:
            ok = False
            bad.append("%s: 盘面实测 = %r, 但清单 current_state 里没有这个值 ⇒ 清单过期"
                       % (item_id, val))
    return ok, ["     %d 个现状探针: 清单里的现状值 == 盘面实测: %s"
                % (len(PROBES), "✔" if ok else "❌")] + ["     ❌ %s" % b for b in bad]


# ★★【ISS-279 · 2026-11-17 17:5x · 追加式收严】★★★ 台账链头三件的【链头判据】★★
#   ★**为什么在「台账里查得到」之上再加一层**: ★**「在台账里查得到」只证明【这个 md5 曾经合法出现过】,
#     不证明【它就是当前该在的那一个】** ⇒ ★**把网表回退到落表前的旧版本 (那个 md5 也在台账里) ⇒
#     上面的判据会放行 ⇒ ★**那就是一个新的假绿** ★
#   ★**所以加链头判据**: ★盘上 md5 必须 == 落表台账【链头】★ ⇒ ★回退 ⇒ 红★ ⇒ ★偷换 ⇒ 红★
#     ⇒ ★合法落表 ⇒ 链头前移 ⇒ 绿★ (★判据方向一个字没变, 只是判得更准 ★)
#   ★**fail-closed 一条都不许放宽**: 链头不唯一 / 链断 / 链头没有落表单号 ⇒ 一律红 ★
#   ★**口径不复制**: 链头算法直接用权威闸 `SW/tools/check_demo_panel_spec.py` 的那一份 (★只读 import★)
#     ⇒ ★**两个闸对同一个盘面不会给出不同答案** (★口径漂移 = 判据失效★) ★
CHAIN_FILES = (
    ("网表", "HW/netlist_v1.csv", "SW_SYNC_NETLIST"),
    ("脚表", "HW/netlist_v1_pins.csv", "SW_SYNC_PINS"),
    ("BOM", "HW/BOM_v1.csv", "SW_SYNC_BOM"),
)

_CDPS = None
_CDPS_TRIED = False


def cdps():
    """★载入 `SW/tools/check_demo_panel_spec.py` (★只读 import · 本单一个字都没改那个文件★)。

    ★读不到 ⇒ 返回 None ⇒ W6 判红 (★fail-closed, 不许静默跳过★)。
    """
    global _CDPS, _CDPS_TRIED
    if _CDPS_TRIED:
        return _CDPS
    _CDPS_TRIED = True
    try:
        import importlib.util
        path = os.path.join(HERE, "check_demo_panel_spec.py")
        spec = importlib.util.spec_from_file_location("_cdps_iss279", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _CDPS = mod
    except Exception:                       # ★读不到 ⇒ fail-closed ★
        _CDPS = None
    return _CDPS


def _symlink_or_copy(src, dst):
    """★符号链接优先 (★4.9 MB 的板不许拷 ★) · 链接不成 ⇒ 退回复制 ★"""
    try:
        os.symlink(os.path.abspath(src), dst)
        return True
    except OSError:
        try:
            shutil.copy2(src, dst)
            return True
        except OSError:
            return False


def _sandbox_root():
    """★沙盒临时根 (★默认放【项目内 tmp/】, 不放 /tmp★) ⇒ 返回目录名或 None (★None = 用系统默认 ★)

    ★★【ISS-298 · 2026-11-18 05:4x · sw-lead】★★ ★**为什么改**:
      ★`/tmp` 是共享 tmpfs (7.5 G) ⇒ 别的单 (hw-lead / mech-lead) 同时跑沙盒就把它塞满 ★
      ⇒ 2026-11-18 05:3x 实跑吃到 **EDQUOT (Errno 122 Disk quota exceeded)** ⇒
        ★本闸 5 条合法改板用例【用例本身坏掉】(拷不进沙盒) ⇒ 整组挂 ⇒ **rc=1** ★
      ⇒ ★**那不是判据坏了, 是门禁在看运气** ★ ⇒ 门禁不许看运气 ⇒ 沙盒挪到项目内 `tmp/` (392 G 可用) ★
    ★**不影响判据**: ★只改「沙盒临时目录放哪」, 一行判据都没动 ★
    ★**可覆盖**: `SW_SYNC_TMPDIR` ⇒ 想放哪放哪 ★
    ★**零写板**: ★沙盒里是 4.9 MB 板的拷贝, 真盘那 5 件受保护文件一个字节都不动 ★
    """
    d = os.environ.get("SW_SYNC_TMPDIR") or os.path.join(PROJ, "tmp")
    try:
        os.makedirs(d, exist_ok=True)
        return d
    except Exception:
        return None


def build_virtual_root(mod):
    """★搭一棵【虚拟根】给权威闸的 `check_r6_hard_protected(root, ...)` 用 ★

    ★**为什么搭**: 权威闸那份判据按【项目根】找文件 (① `SW/SW_MD5_BASELINE_LEDGER.md`
      ② `HW/PCB/demo_mainboard.kicad_pcb` / `.kicad_pro`) ⇒ 本闸在沙盒里跑反向用例时
      盘上文件路径由 env 覆盖 ⇒ ★搭一棵【符号链接虚拟根】把权威闸的路径口径接上 ★
    ★**为什么这么搭 (★不重写判据★)**: ★**判据本体一个字都不重写** ⇒ 直接调用权威闸那份
      `check_r6_hard_protected()` ⇒ ★两个闸对同一个盘面永远给同一个答案 (★口径不漂移★) ★
    ★**零写板**: 链接只指不写 ⇒ ★真盘那 5 件受保护文件一个字节都不会被动 ★
    ★返回 (虚拟根路径, 锚点 dict 或 None, 原因) ★
    """
    tmp = tempfile.mkdtemp(prefix="iss298_vroot_", dir=_sandbox_root())
    try:
        os.makedirs(os.path.join(tmp, "SW"), exist_ok=True)
        os.makedirs(os.path.join(tmp, "HW", "PCB"), exist_ok=True)
        _symlink_or_copy(ledger_path(), os.path.join(tmp, mod.LEDGER_DOC))
        _symlink_or_copy(landing_ledger_path(), os.path.join(tmp, mod.LEDGER_CANON))
        anchors, err = mod.load_sw_anchor(tmp)
        if anchors is None:
            return tmp, None, err
        for e in (anchors.get("hard_protected") or []):
            rel = str(e.get("file") or "")
            if not rel:
                continue
            env_key = HARD_REL_ENV.get(rel)
            src = (os.environ.get(env_key) if env_key else None) or os.path.join(PROJ, rel)
            dst = os.path.join(tmp, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if os.path.exists(src):
                _symlink_or_copy(src, dst)
        return tmp, anchors, ""
    except Exception:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


def check_W6():
    ok, bad = True, []
    pmap = protected_map()
    # ---- 第三条 (★现在叫 (d)★): 落表台账文本 (★append-only 的信任边界★) ----
    led_txt = ""
    landing = landing_ledger_path()
    if os.path.exists(landing):
        led_txt = read_text(landing)
    else:
        ok = False
        bad.append("落表台账读不到: %s ⇒ 无从对账 (fail-closed)" % landing)
    for name, path in pmap.items():
        if not os.path.exists(path):
            ok = False
            bad.append("%s 不存在: %s" % (name, path))
            continue
        cur = md5(path)
        # ★★★【2026-11-17 17:4x · ISS-279 收口轮 · 追加式修订】★★★ ★基线口径 = 【可追溯的真源】,
        #   不是【字面量】★★ ⇒ 5 件一律: ★**盘上 md5 必须在落表台账里查到** ★
        #   ⇒ 合法落表 (如 2026-11-17 12:30:23 ISS-283) / 合法改板 ⇒ 自动跟随 (链头前移) ⇒ 绿
        #   ⇒ 改了却没落表记录 (偷换真源) ⇒ 查不到 ⇒ 红
        #   ⇒ ★**硬保护两件的合法性 (单号背书 / 同组覆盖 / fail-closed) 由权威闸
        #      `SW/tools/check_demo_panel_spec.py` 的 R6 判 (★ISS-284 的 reboard 机制★)
        #      ⇒ 本闸【不自造第二套合法改板判据】, 只保证「盘上必须是台账记过的状态」+「锚点没被手改」★
        if led_txt and not (cur in led_txt or cur[:12] in led_txt):
            ok = False
            bad.append("%s md5 %s 在落表台账 (%s) 里查不到 ⇒ 改了却没落表记录 "
                       "(★悄悄换真源 = 红★ · 合法落表自动前移 ⇒ 绿★)"
                       % (name, cur, os.path.basename(landing)))
    # ---- ★★【ISS-298 · 2026-11-17 · sw-lead】★★ 硬保护两件 (板 / `.kicad_pro`)
    #      = 【合法改板通道】⇒ ★**判据本体逐字照搬权威闸** (★只读调用, 一个字节都没重写 ★)
    #      ① 保护基线自证 · ② 无变更行 ⇒ 纯 md5 硬保护 · ③ 有变更行 ⇒ 链头 + reboard 四项
    #      ④ 同组受保护件覆盖 (★fail-closed 三条在权威闸里, 一条不许放宽 ★)
    mod = cdps()
    if mod is None:
        ok = False
        bad.append("读不到权威闸 SW/tools/check_demo_panel_spec.py "
                   "(合法改板 / 链头判据的唯一真源) ⇒ fail-closed")
    else:
        vroot = None
        try:
            vroot, anchors, err = build_virtual_root(mod)
            if anchors is None:
                ok = False
                bad.append("读不到 SW 台账 §1 锚点块 ⇒ fail-closed: %s" % err)
            else:
                spec = os.path.basename(landing)
                for f in mod.check_r6_hard_protected(vroot, anchors, led_txt, spec):
                    ok = False
                    bad.append(f)
        except Exception as exc:
            ok = False
            bad.append("合法改板判据算不出来 (%s) ⇒ fail-closed" % exc)
        finally:
            if vroot:
                shutil.rmtree(vroot, ignore_errors=True)
    # ---- ★★第四条 (★2026-11-17 17:5x 追加式收严★): 台账链头三件 (网表 / 脚表 / BOM)
    #      盘上 md5 必须 == 落表台账【链头】⇒ 回退旧版本也红 ⇒ 合法落表链头前移 ⇒ 绿 ★
    if mod is not None and led_txt:
        for name, rel, env_key in CHAIN_FILES:
            path = os.environ.get(env_key) or os.path.join(PROJ, rel)
            if not os.path.exists(path):
                ok = False
                bad.append("%s 不存在: %s" % (name, path))
                continue
            cur = md5(path)
            try:
                state = mod.sw_ledger_state(rel, led_txt)
            except Exception as exc:
                ok = False
                bad.append("%s 链头算不出来 (%s) ⇒ fail-closed" % (name, exc))
                continue
            head = state.get("head")
            if not head:
                ok = False
                bad.append("%s 落表台账链头取不准 (%s) ⇒ fail-closed (★不许放宽成「取最近一条」★)"
                           % (name, state.get("why") or "无链头"))
                continue
            if not state.get("head_iss"):
                ok = False
                bad.append("%s 链头没有落表单号 ⇒ fail-closed" % name)
                continue
            if cur[:12].lower() != str(head)[:12].lower():
                ok = False
                bad.append("%s 盘上 md5 = %s ≠ 落表台账链头 = %s (产出单号 %s) ⇒ 真源被换了 / 被回退了"
                           % (name, cur[:12], str(head)[:12], ",".join(state.get("head_iss") or [])))
    # ---- 第二条: SW 台账 §1 锚点块里那两个 md5 一个字节不许动 (★不许手改 md5 凑绿 ★)
    #      (★★【ISS-298】这条的【角色】= 锚点本体的防篡改报警, 不再是「盘上是否合法」的判决源 ★)
    led = ledger_path()
    if not os.path.exists(led):
        ok = False
        bad.append("SW 台账不存在: %s" % led)
    else:
        txt = read_text(led)
        m = re.search(r"#\s*BEGIN\s+SW_MD5_ANCHORS(.*?)#\s*END\s+SW_MD5_ANCHORS", txt, re.S)
        if not m:
            ok = False
            bad.append("SW 台账 §1 锚点块 (# BEGIN/END SW_MD5_ANCHORS) 读不到 ⇒ fail-closed")
        else:
            blk = m.group(1)
            for rel, want in ANCHOR_MD5.items():
                mm = re.search(r"-\s*file:\s*%s\s*\n\s*md5:\s*([0-9a-fA-F]{32})"
                               % re.escape(rel), blk)
                if not mm:
                    ok = False
                    bad.append("台账 §1 锚点块里找不到 %s 的 md5 条目 ⇒ 硬保护件失保护" % rel)
                    continue
                got = mm.group(1).lower()
                if got != want:
                    ok = False
                    bad.append("台账 §1 锚点块里 %s 的 md5 = %s ≠ 基线 %s ⇒ 有人手改 md5 凑绿"
                               % (rel, got, want))
    return ok, ["     受保护 5 件: 盘上 md5 必须在落表台账里查到 (合法落表自动前移 · 偷换照红) "
                "+ 硬保护两件走【合法改板通道】(★台账链头 + reboard 四项原子映射 · 判据逐字照搬权威闸★) "
                "+ 台账 §1 锚点块两个 md5 未被手改 (★不许手改 md5 凑绿★): %s"
                % ("✔" if ok else "❌")] + ["     ❌ %s" % b for b in bad]


CHECKS = {
    "W1": lambda items, txt: check_W1(items),
    "W2": lambda items, txt: check_W2(items),
    "W3": lambda items, txt: check_W3(items),
    "W4": lambda items, txt: check_W4(items, txt),
    "W5": lambda items, txt: check_W5(items),
    "W6": lambda items, txt: check_W6(),
}


def evaluate(checklist_path, only=None):
    items, txt = load_items(checklist_path)
    lines, ok = [], True
    for cid, fn in CHECKS.items():
        if only and cid != only:
            continue
        r_ok, r_lines = fn(items, txt)
        lines.append("  %s  %s" % ("OK " if r_ok else "FAIL", cid))
        lines.extend(r_lines)
        ok = ok and r_ok
    return ok, lines


# ==============================================================================
# --selftest
# ==============================================================================
def write_variant(src_path, dst_path, mutate):
    """★把清单页的 JSON 块换掉, 写一份副本 (★用来做反向用例 ★)"""
    txt = read_text(src_path)
    m = re.search(r"```json\s*(\{.*?\})\s*```", txt, re.S)
    data = json.loads(m.group(1))
    mutate(data)
    new_block = "```json\n%s\n```" % json.dumps(data, ensure_ascii=False, indent=2)
    txt2 = txt[:m.start()] + new_block + txt[m.end():]
    open(dst_path, "w", encoding="utf-8").write(txt2)
    return dst_path


# ==============================================================================
# ★★【ISS-298 · 2026-11-17 · sw-lead】★★ 合法改板通道 · 沙盒工具
#   (★形状照抄权威闸 `SW/tools/check_demo_panel_spec.py --selftest` 的 REV-16~REV-21 ★)
#   (★★真盘零写: 板 / 两份台账 全是临时目录里的拷贝, 真盘那 5 件受保护文件一个字节都不动 ★★)
# ==============================================================================
def _sb_board_copy(src, dst):
    """★把板拷进沙盒并改一个字节 (★真盘一个字节都不许动 ★) ⇒ 返回新 md5 ★"""
    shutil.copy2(src, dst)
    with open(dst, "ab") as f:
        f.write(b"\n# ISS-298 selftest: sandbox legal reboard (temp only)\n")
    return md5(dst)


def _sb_anchor_block(path):
    """★取沙盒台账 §1 锚点块的 YAML dict ★"""
    import yaml
    txt = read_text(path)
    m = re.search(r"#\s*BEGIN\s+SW_MD5_ANCHORS(.*?)#\s*END\s+SW_MD5_ANCHORS", txt, re.S)
    if not m:
        raise AssertionError("沙盒台账里找不到锚点块")
    return yaml.safe_load(m.group(1)) or {}


def _sb_anchor_base(path, rel):
    """★沙盒台账锚点块里某件的【保护基线】 md5 ★"""
    data = _sb_anchor_block(path)
    for e in ((data.get("anchors") or {}).get("hard_protected") or []):
        if str(e.get("file") or "") == rel:
            return str(e.get("md5") or "")
    raise AssertionError("锚点里没有 %s 的保护基线" % rel)


def _sb_rewrite_anchor(path, fn):
    """★只用于 selftest 沙盒: 改 SW 台账 §1 锚点块 (★真盘的锚点块不许这样整块重写 ★)"""
    import yaml
    txt = read_text(path)
    m = re.search(r"#\s*BEGIN\s+SW_MD5_ANCHORS(.*?)#\s*END\s+SW_MD5_ANCHORS", txt, re.S)
    if not m:
        raise AssertionError("沙盒台账里找不到锚点块")
    data = yaml.safe_load(m.group(1)) or {}
    fn(data)
    block = ("# BEGIN SW_MD5_ANCHORS\n"
             + yaml.safe_dump(data, allow_unicode=True, sort_keys=False,
                              default_flow_style=False)
             + "# END SW_MD5_ANCHORS")
    with open(path, "w", encoding="utf-8") as f:
        f.write(txt[:m.start()] + block + txt[m.end():])


def _sb_row(ticket, rel, prev, new, note="★**是** ★"):
    """★落表台账行 (★格式契约: 单号 | 文件名 | 改前 md5 | 改后 md5 四项同行 ★)"""
    return "| %s | `%s` | `%s` | `%s` | %s |" % (ticket, rel, prev, new, note)


def _sb_rows_full_legal(base, new, pro_base):
    """★合法改板的样子: 板一行变更 + `.kicad_pro` 一行「逐字节不变」, 同一单号 ★"""
    return [_sb_row(SW_TICKET_A, SW_BOARD_REL, base, new, "★**是 (★合法改板·板只改一次★)** ★"),
            _sb_row(SW_TICKET_A, SW_PRO_REL, pro_base, pro_base, "★**否 (★逐字节不变★)** ★")]


def _sb_rows_two_heads(base, new, pro_base):
    """★两条合法改板记录指向同一个文件 ⇒ 链头不唯一 ★"""
    return [_sb_row(SW_TICKET_A, SW_BOARD_REL, base, new, "★**是 (★合法改板★)** ★"),
            _sb_row(SW_TICKET_B, SW_BOARD_REL, base, "deadbeefdeadbeefdeadbeefdeadbeef",
                    "★**是 (★第二跳·另一个头★)** ★"),
            _sb_row(SW_TICKET_A, SW_PRO_REL, pro_base, pro_base, "★**否 (★逐字节不变★)** ★")]


def _sb_rows_broken_chain(base, new, pro_base):
    """★链断: 台账记的是 (base→中间→链头), 而锚点写的改前 md5 是 base ★"""
    mid = "0123456789abcdef0123456789abcdef"
    return [_sb_row(SW_TICKET_A, SW_BOARD_REL, base, mid, "★**是 (★上一跳★)** ★"),
            _sb_row(SW_TICKET_A, SW_BOARD_REL, mid, new, "★**是 (★本跳·链头★)** ★"),
            _sb_row(SW_TICKET_A, SW_PRO_REL, pro_base, pro_base, "★**否 (★逐字节不变★)** ★")]


def _sb_rows_board_only(base, new, pro_base):
    """★只改板不动 `.kicad_pro` ⇒ 两件的记录只来一条 ★"""
    return [_sb_row(SW_TICKET_A, SW_BOARD_REL, base, new, "★**是 (★合法改板★)** ★")]


def _sb_reboard(tmpd, mode="reboard", rows_fn=None):
    """★在沙盒里做一次「合法改板」⇒ 返回 (env 覆盖表, 新板 md5, 基线 md5) ★

    ★`mode`:
      "reboard"  ⇒ 锚点写原子 reboard 四项 (★合法那一支 ★)
      "md5_only" ⇒ 只改锚点里的 md5, 单号字段不写 (★挖坑那一支 ★)
    ★真盘一个字节都不动: 板 / 两份台账全是临时目录里的拷贝 ★
    """
    board_src = os.path.join(PROJ, "HW", "PCB", "demo_mainboard.kicad_pcb")
    board_sb = os.path.join(tmpd, "sb_board.kicad_pcb")
    newmd5 = _sb_board_copy(board_src, board_sb)
    led_sb = os.path.join(tmpd, "sb_sw_ledger.md")
    shutil.copy2(ledger_path(), led_sb)
    land_sb = os.path.join(tmpd, "sb_landing.md")
    shutil.copy2(landing_ledger_path(), land_sb)
    base = _sb_anchor_base(led_sb, SW_BOARD_REL)
    pro_base = _sb_anchor_base(led_sb, SW_PRO_REL)

    def _fn(data):
        for e in (data.get("anchors") or {}).get("hard_protected") or []:
            if e.get("file") != SW_BOARD_REL:
                continue
            if mode == "md5_only":
                e["md5"] = newmd5          # ★只改 md5, 不写单号 ⇒ 挖坑 ★
            else:
                e["reboard"] = {"by": SW_TICKET_A, "file": SW_BOARD_REL,
                                "prev_md5": base, "md5": newmd5}
    _sb_rewrite_anchor(led_sb, _fn)
    rows = rows_fn(base, newmd5, pro_base) if rows_fn else []
    if rows:
        with open(land_sb, "a", encoding="utf-8") as f:
            f.write("\n" + "\n".join(rows) + "\n")
    return ({"SW_SYNC_PCB": board_sb, "SW_SYNC_LEDGER": led_sb, "SW_SYNC_LANDING": land_sb},
            newmd5, base)


def run_selftest(checklist_path):
    tmpd = tempfile.mkdtemp(prefix="iss279_selftest_", dir=_sandbox_root())
    cases = []
    try:
        # ① 删掉 ①~⑧ 里的一条 ⇒ W4 红
        p = os.path.join(tmpd, "v1.md")
        write_variant(checklist_path, p, lambda d: d["items"].remove(
            next(i for i in d["items"] if i["id"] == "SW03_LAND8_DNP")))
        ok, _ = evaluate(p, only="W4")
        cases.append(("① 删掉 ①~⑧ 里的 SW03_LAND8_DNP ⇒ W4 红", ok is False))

        # ② 归属步改成 S99 ⇒ W2 红
        p = os.path.join(tmpd, "v2.md")
        def mut2(d):
            next(i for i in d["items"] if i["id"] == "SW07_C_VBUS_GND")["step"] = "S99"
        write_variant(checklist_path, p, mut2)
        ok, _ = evaluate(p, only="W2")
        cases.append(("② 把归属步改成 S99 ⇒ W2 红", ok is False))

        # ③ 判据命令指向不存在的脚本 ⇒ W3 红
        p = os.path.join(tmpd, "v3.md")
        def mut3(d):
            next(i for i in d["items"] if i["id"] == "SW01_PCB_MD5")["criterion"] = \
                "python3 SW/tools/check_onepass_sw_does_not_exist_zzz.py ⇒ rc=0"
        write_variant(checklist_path, p, mut3)
        ok, _ = evaluate(p, only="W3")
        cases.append(("③ 判据命令指向不存在的脚本 ⇒ W3 红", ok is False))

        # ④ 把某条 [实测] 值改错 (板 md5 改一位) ⇒ W5 红
        p = os.path.join(tmpd, "v4.md")
        def mut4(d):
            it = next(i for i in d["items"] if i["id"] == "SW01_PCB_MD5")
            it["current_state"] = it["current_state"].replace(
                "611b869e13518c3c023fb178f91a0075", "611b869e13518c3c023fb178f91a0076")
        write_variant(checklist_path, p, mut4)
        ok, _ = evaluate(p, only="W5")
        cases.append(("④ 把板 md5 改错一位 ⇒ W5 红 (清单过期当场被抓)", ok is False))

        # ⑤ 改受保护 5 件之一 (板) ⇒ W6 红
        pcb_src = protected_map()["板"]
        pcb_bad = os.path.join(tmpd, "board_bad.kicad_pcb")
        with open(pcb_bad, "w", encoding="utf-8") as f:
            f.write(read_text(pcb_src) + "\n; ★selftest 注入的一行 ★\n")
        old = os.environ.get("SW_SYNC_PCB")
        os.environ["SW_SYNC_PCB"] = pcb_bad
        ok, _ = evaluate(checklist_path, only="W6")
        if old is None:
            os.environ.pop("SW_SYNC_PCB", None)
        else:
            os.environ["SW_SYNC_PCB"] = old
        cases.append(("⑤ 板文件被改一个字节 ⇒ W6 红", ok is False))

        # ⑥ 改台账 §1 锚点块里板的 md5 ⇒ W6 红 (★「不许手改 md5 凑绿」那一条 ★)
        led_src = os.environ.get("SW_SYNC_LEDGER") or LEDGER
        led_bad = os.path.join(tmpd, "ledger_bad.md")
        t = read_text(led_src)
        assert "611b869e13518c3c023fb178f91a0075" in t
        with open(led_bad, "w", encoding="utf-8") as f:
            f.write(t.replace("md5: 611b869e13518c3c023fb178f91a0075",
                              "md5: 611b869e13518c3c023fb178f91a0076", 1))
        old = os.environ.get("SW_SYNC_LEDGER")
        os.environ["SW_SYNC_LEDGER"] = led_bad
        ok, _ = evaluate(checklist_path, only="W6")
        if old is None:
            os.environ.pop("SW_SYNC_LEDGER", None)
        else:
            os.environ["SW_SYNC_LEDGER"] = old
        cases.append(("⑥ 台账 §1 锚点块里板的 md5 被手改 ⇒ W6 红 (★不许手改 md5 凑绿★)", ok is False))

        # ⑦ 抽掉一条的一个字段 ⇒ W1 红
        p = os.path.join(tmpd, "v7.md")
        def mut7(d):
            next(i for i in d["items"] if i["id"] == "SW05_KEY_NETNAMES").pop("criterion")
        write_variant(checklist_path, p, mut7)
        ok, _ = evaluate(p, only="W1")
        cases.append(("⑦ 抽掉一条的 criterion 字段 ⇒ W1 红", ok is False))

        # ⑧ source_iss 改成来源不明 ⇒ W4 红
        p = os.path.join(tmpd, "v8.md")
        def mut8(d):
            next(i for i in d["items"] if i["id"] == "SW06_TP_INT")["source_iss"] = "ISS-999"
        write_variant(checklist_path, p, mut8)
        ok, _ = evaluate(p, only="W4")
        cases.append(("⑧ source_iss 改成来源不明 (ISS-999) ⇒ W4 红", ok is False))

        # ⑨ 把网表【回退到落表前的旧版本】(★那个 md5 在落表台账里查得到 ⇒ 「在台账里查得到」放行它 ★)
        #    ⇒ 靠【链头判据】抓 ⇒ W6 红 (★防「回退真源」这类假绿 ★)
        old_net = os.path.join(PROJ, "state", ".bak_iss220", "HW_netlist_v1.csv.bak_iss220")
        if os.path.exists(old_net):
            oldmd5 = md5(old_net)
            old = os.environ.get("SW_SYNC_NETLIST")
            os.environ["SW_SYNC_NETLIST"] = old_net
            ok, _ = evaluate(checklist_path, only="W6")
            if old is None:
                os.environ.pop("SW_SYNC_NETLIST", None)
            else:
                os.environ["SW_SYNC_NETLIST"] = old
            cases.append(("⑨ 网表被回退到旧版本 (md5 %s · 在台账里查得到但不是链头) ⇒ W6 红"
                          % oldmd5[:12], ok is False))
        else:
            cases.append(("⑨ 网表回退用例 ★跳过 (旧版备份不在盘上)★", True))

        # ================================================================
        # ★★【ISS-298 · 2026-11-17 · sw-lead】★★ 合法改板通道 · 6 条
        #   (★形状照抄权威闸 `--selftest` 的 REV-16~REV-21 ★· 沙盒跑 · 真盘零写 ★)
        #   (★每条都【自证改到了目标】★ ⇒ 真抓到那条判据才算数 ★)
        # ================================================================
        reboard_cases = [
            ("⑩ 只改锚点里的板 md5, 单号字段没写 (★挖坑★)", False, "md5_only", None),
            ("⑪ 锚点写了 reboard 四项, 但落表台账里查不到那一行", False, "reboard", None),
            ("⑫ 台账里两条合法改板记录指向同一个文件 (链头不唯一)", False, "reboard",
             _sb_rows_two_heads),
            ("⑬ 链断 (改前 md5 对不上台账记的上一次改后 md5)", False, "reboard",
             _sb_rows_broken_chain),
            ("⑭ 只改板不动 .kicad_pro (两件记录只来一条)", False, "reboard", _sb_rows_board_only),
            ("⑮ 合法改板: 台账四项齐全 + 锚点原子记录 ⇒ 放行 (★正向★)", True, "reboard",
             _sb_rows_full_legal),
        ]
        for name, expect_green, mode, rows_fn in reboard_cases:
            sub = tempfile.mkdtemp(prefix="iss298_rb_", dir=tmpd)
            try:
                envov, newmd5, base = _sb_reboard(sub, mode, rows_fn)
            except Exception as exc:
                cases.append(("★ISS-298★ %s ★用例本身坏了 (%s)★" % (name, exc), False))
                continue
            saved = dict((k, os.environ.get(k)) for k in envov)
            os.environ.update(envov)
            try:
                ok, lines = evaluate(checklist_path, only="W6")
            finally:
                for k, v in saved.items():
                    if v is None:
                        os.environ.pop(k, None)
                    else:
                        os.environ[k] = v
            hit = [l for l in lines if "R6 硬保护" in l]
            if expect_green:
                caught = (ok is True) and not hit
                why = "W6 仍绿 (★合法改板四项齐全 = 放行★ · 板 md5 %s → 台账链头)" % newmd5[:12]
            else:
                caught = (ok is False) and bool(hit)
                why = "W6 红 (%s)" % (hit[0].strip()[:64] if hit else "★没看到 R6 硬保护字样★")
            cases.append(("★ISS-298★ %s ⇒ %s" % (name, why), caught))

        # ★基线: 真盘必须全绿 (否则上面那些红没意义)
        ok0, _ = evaluate(checklist_path)
        cases.append(("★基线: 真盘 W1~W6 全绿", ok0 is True))
    finally:
        shutil.rmtree(tmpd, ignore_errors=True)

    print("=" * 78)
    print("  ISS-279 · 反向用例 (★每条都自证「真的改到了目标」 ★)")
    print("=" * 78)
    bad = 0
    for name, caught in cases:
        mark = "✔" if caught else "✘"
        if not caught:
            bad += 1
        print("  %s  %s" % (mark, name))
    print("-" * 78)
    print("  反向用例 %d/%d 通过" % (len(cases) - bad, len(cases)))
    if bad:
        print("  ❌ 有反向用例没抓到 ⇒ 闸不是判据 (或用例本身写错了)")
        return 1
    print("  ✅ 反向用例全抓到 ⇒ 判据真在被读 (★不是把红灯调没 ★)")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--checklist", default=CHECKLIST)
    args = ap.parse_args()

    if not os.path.exists(args.checklist):
        print("❌ 用法错: 找不到清单页 %s" % args.checklist)
        return 2

    if args.selftest:
        return run_selftest(args.checklist)

    print("=" * 78)
    print("  ISS-279 · SW 侧板侧输入收口闸 (★W1 清单 / W2 归属步 / W3 判据真命令 / W4 覆盖度 / W5 现状 / W6 受保护★)")
    print("=" * 78)
    ok, lines = evaluate(args.checklist)
    for l in lines:
        print(l)
    print("-" * 78)
    if ok:
        print("  ✅ rc=0: ★★SW 侧板侧输入清单齐全 (①~⑧ 八条一条不缺) 且现状值与盘面一致 ★★")
        return 0
    print("  ❌ rc=1: ★★SW 侧清单有漏项, 或现状值已过期 ⇒ 那一趟改完 SW 侧会漂一处 ★★")
    return 1


if __name__ == "__main__":
    sys.exit(main())

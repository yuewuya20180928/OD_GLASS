xt-body-md text-[#555] no-underline hover:underline focus:underline" id="ti-breadcrumb-section-3-item-20" href="https://www.ti.com/en-us/product-category/power-management/voltage-references" data-navtitle="Voltage references">Voltage references</a></li></ul></ti-breadcrumb-section></ti-breadcrumb></div></nav><div data-component="generic-wrappers/section-wrapper" class="relative flex flex-col items-start self-stretch w-full container-lg box-border! mx-auto space-10 trackingGenericPageHeadingGoldenSourced pb-12 md:pb-20"><div class="w-full flex flex-col space-y-4"><div><div class="flex flex-col [&amp;&gt;*]:mb-0 [&amp;&gt;h1]:text-hero md:[&amp;&gt;h1]:leading-[var(--spacing-16)]"><h1>Supervisor &amp; reset ICs</h1><div class="mt-8 text-h4 md:leading-[var(--spacing-9)] font-light [&amp;_strong]:font-medium [&amp;_b]:font-medium [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ps-8 [&amp;_ol]:ps-8 [&amp;_*:last-child]:mb-0"><div><p>Continuous voltage and power-rail monitoring</p></div></div><div class="mt-8"><tif-button-group><tif-button class="trackingGoldenSourcedCtaButton [--tifButton-fontSize:14px] [--tifButton-minHeight:40px]">View all products</tif-button></tif-button-group></div></div></div></div></div><div style="width:100%;display:block"><div id="browse-by-category" class="trackingSection general-section"><div class="w-full"><div class="relative w-full theme-root theme-grey BrandAndThemeContext-module__XLl7IW__themeRoot text-text-default"><div data-component="generic-wrappers/section-wrapper" class="relative flex flex-col items-start self-stretch w-full container-lg box-border! mx-auto space-10 pt-8 md:pt-12 pb-8 md:pb-12"><div class="w-full flex flex-col space-y-4"><div class="container"><div class="flex flex-column bg-{var(--component-section-color-bg)}"><div data-component="generic-wrappers/preamble-section-wrapper" class="flex flex-col w-full gap-8"><div data-preamble-width-cap="true" class="flex w-full flex-col gap-8 md:max-w-2/3 text-left"><div class="text-left trackingHeadline flex flex-col"><div class=""><h2 class="text-inherit! mb-0 heading-text-h2">Browse by category</h2></div></div></div><div class="space-y-4 py-4"><div class="trackingContentBlock flex w-full flex-col gap-8"><div class="rich-text"><p>Our portfolio of voltage supervisors and reset integrated circuits (ICs) includes watchdog timers, push-button, voltage detectors, fixed-time delay supervisors and programmable time-delay supervisors. Also known as voltage monitors, supervisor and reset ICs continuously monitor system health to ensure proper operation. Integrated features provide flexibility across applications including automotive, industrial and personal electronics.</p></div></div><div class="trackingProductCategoryList"><ul class="list-none gap-x-14 m-0 mt-4 p-0 columns-1 md:columns-2"><li class="flex py-4 break-inside-avoid -mb-px border-y border-y-[#e8e8e8] text-lg leading-6"><a class="flex items-center w-full text-inherit" href="https://www.ti.com/en-us/product-category/power-management/supervisor-reset-ics/reset-watchdog"><span class="inline-flex grow text-l leading-7 font-normal">Reset &amp; watchdog ICs</span><ti-svg-icon icon-name="arrow-right" appearance="" class="grow-0 shrink-0 [--ti-svg-icon-fill-color:#007c8c]"></ti-svg-icon></a></li><li class="flex py-4 break-inside-avoid -mb-px border-y border-y-[#e8e8e8] text-lg leading-6"><a class="flex items-center w-full text-inherit" href="https://www.ti.com/en-us/product-category/power-management/supervisor-reset-ics/supply-voltage-supervisors"><span class="inline-flex grow text-l leading-7 font-normal">Supply-voltage supervisors</span><ti-svg-icon icon-name="arrow-right" appearance="" class="grow-0 shrink-0 [--ti-svg-icon-fill-color:#007c8c]"></ti-svg-icon></a></li></ul></div></div></div></div></div></div></div></div></div></div></div><div style="width:100%;display:block"><div id="portfolio-visualizer" class="trackingSection general-section"><div class="w-full"><div class="relative w-full theme-root theme-white BrandAndThemeContext-module__XLl7IW__themeRoot text-text-default"><div data-component="generic-wrappers/section-wrapper" class="relative flex flex-col items-start self-stretch w-full container-lg box-border! mx-auto space-10 pt-8 md:pt-12 pb-8 md:pb-12"><div class="w-full flex flex-col space-y-4"><div class="container"><div class="flex flex-column bg-{var(--component-section-color-bg)}"><div data-component="generic-wrappers/preamble-section-wrapper" class="flex flex-col w-full gap-8"><div data-preamble-width-cap="true" class="flex w-full flex-col gap-8 md:max-w-2/3"><div class="trackingHeadline flex flex-col"><div class=""><h2 class="text-inherit! mb-0">Featured products</h2></div></div></div><div class="space-y-4 py-4"><ti-tab-container class="trackingTabs" appearance="regular" theme="light"><ti-tab-panel class="trackingGeneralTab" tab-id="random_t_p6KOcbWJ7s-eyOWaYSc" tab-title="Supply-voltage supervisors"><div class="overflow-x-auto border border-pl-border-color-primary p-8 trackingPortfolioVisualization"><ti-portfolio-viewer svg-url="https://dam.ti.com/asset/1291bd40-773f-40e3-892a-23d87612daca/LP-VRS-Supervisors-Reset-ICs-Portfolio-Visualization.svg" locale="en-us" class="min-w-[1024px] md:min-w-0"></ti-portfolio-viewer></div></ti-tab-panel><ti-tab-panel class="trackingGeneralTab" tab-id="random_AL0SBtz6N-kfFoLSzeudS" tab-title="Reset &amp; watchdog ICs"><div class="overflow-x-auto border border-pl-border-color-primary p-8 trackingPortfolioVisualization"><ti-portfolio-viewer svg-url="https://dam.ti.com/asset/5c42325a-faef-4052-ae0c-527d58d311ca/LP-VRS-reset-watchdog-ICs-portfolio-visualization.svg" locale="en-us" class="min-w-[1024px] md:min-w-0"></ti-portfolio-viewer></div></ti-tab-panel></ti-tab-container></div></div></div></div></div></div></div></div></div></div><div style="width:100%;display:block"><div id="family-technologies" class="trackingSection general-section"><div class="w-full"><div class="relative w-full theme-root theme-grey BrandAndThemeContext-module__XLl7IW__themeRoot text-text-default"><div data-component="generic-wrappers/section-wrapper" class="relative flex flex-col items-start self-stretch w-full container-lg box-border! mx-auto space-10 pt-8 md:pt-12 pb-8 md:pb-12"><div class="w-full flex flex-col space-y-4"><div class="container"><div class="flex flex-column bg-{var(--component-section-color-bg)}"><div data-component="generic-wrappers/preamble-section-wrapper" class="flex flex-col w-full gap-8"><div data-preamble-width-cap="true" class="flex w-full flex-col gap-8 md:max-w-2/3"><div class="trackingHeadline flex flex-col"><div class=""><h2 class="text-inherit! mb-0">Power trends</h2></div></div></div><div class="space-y-4 py-4"><ti-tab-container class="trackingTabs" appearance="regular" theme="light"><ti-tab-panel class="trackingGeneralTab" tab-id="random_8W-dpPVz7l9ZGuSQXLoxn" tab-title="Low quiescent current (I&lt;sub&gt;Q&lt;/sub&gt;)"><div class="trackingColumnGrid grid gap-7 grid-cols-12"><div class="trackingColumnGridColumn col-span-12 md:col-span-6 grid [&amp;_[data-preamble-width-cap]]:max-w-none"><div class="trackingContentBlock flex w-full flex-col gap-8"><div class="text-left flex flex-col"><div class=""><h3 class="text-inherit! mb-0">Low quiescent current (IQ)</h3></div></div><div class="rich-text"><p>Low quiescent current (I<sub>Q</sub>)</p><p>Achieve ultra-low quiescent current (I<sub>Q</sub>) without giving up system performance with our wide portfolio of voltage supervisors and reset integrated circuits (ICs). Our low-I<sub>Q</sub> supervisors provide continuous voltage and power-rail monitoring while operating at low standby power, enabling longer battery run times, faster dynamic response times and a small form factor, all while maintaining ultra-low quiescent power consumption.</p></div></div></div><div class="trackingColumnGridColumn col-span-12 md:col-span-6 grid [&amp;_[data-preamble-width-cap]]:max-w-none"><div class="trackingImage"><ti-image src="https://dam.ti.com/transform/42d5589e-04f7-472e-9a50-3502387d0d3a/Low-IQ-testing-board-with-laptop" alt="Low quiescent current (I&lt;sub&gt;Q&lt;/sub&gt;)"></ti-image></div></div></div><div class="grid gap-4 md:gap-x-14 md:gap-y-10 md:grid-cols-3 trackingMixedCardList"></div></ti-tab-panel><ti-tab-panel class="trackingGeneralTab" tab-id="random_5yRTmtMFZbvIAtHFLF2hr" tab-title="High precision"><div class="trackingColumnGrid grid gap-7 grid-cols-12"><div class="trackingColumnGridColumn col-span-12 md:col-span-6 grid [&amp;_[data-preamble-width-cap]]:max-w-none"><div class="trackingContentBlock flex w-full flex-col gap-8"><div class="text-left flex flex-col"><div class=""><h3 class="text-inherit! mb-0">High precision</h3></div></div><div class="rich-text">High precision<p>Our high-accuracy supervisors and reset ICs enable better regulation in power supplies and safer operation in critical grid infrastructure, motor drive and industrial automation systems.</p></div></div></div><div class="trackingColumnGridColumn col-span-12 md:col-span-6 grid [&amp;_[data-preamble-width-cap]]:max-w-none"><div class="trackingImage"><ti-image src="https://dam.ti.com/transform/4a33e68e-03a6-4d6c-9d52-98e093eafda4/LM25149-Q1EVM-2100" alt="High precision"></ti-image></div></div></div><div class="grid gap-4 md:gap-x-14 md:gap-y-10 md:grid-cols-3 trackingMixedCardList"><div class="group relative h-full trackingAuthoredCard"><ti-card appearance="plain-white"><a slot="card-link" aria-hidden="true" tabindex="-1" href="https://www.ti.com/en-us/design-development/educational-resources/video/series/voltage-supervisors-101"></a><div class="flex h-full flex-col"><div class="empty:hidden [&amp;_img]:aspect-video -mx-6 -mt-6 mb-6 [&amp;_img]:block [&amp;_img]:object-cover"><ti-image src="https://dam.ti.com/transform/7aea486f-b523-4edf-9945-afb2aeeb1af2/TI-stacked-red-logo" alt="" ratio="rectangle"></ti-image></div><div class="text-label font-normal uppercase empty:hidden text-pl-text-color-primary mb-2"></div><h3 class="mb-4 text-pl-text-color-primary text-h4"><a class="text-inherit" href="https://www.ti.com/en-us/design-development/educational-resources/video/series/voltage-supervisors-101"><span>Voltage supervisors 101</span></a></h3><div class="mb-4 grow text-body-md empty:mb-0"><div>This training series covers a wide range of topics including the introduction to supervisors and also understanding the key specifications and features that a supervisor can bring to your subsystem.</div></div><div inert="" class="text-body-md"><a href="/en-us/design-development/educational-resources/video/series/voltage-supervisors-101" class="trackingCtaLink tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">Voltage supervisors 101</span></a></div></div></ti-card></div><div class="group relative h-full trackingLiteratureCard"><ti-card appearance="plain-white"><div class="flex h-full flex-col"><div class="empty:hidden [&amp;_img]:aspect-video -mx-6 -mt-6 mb-6 [&amp;_img]:block [&amp;_img]:object-cover"><ti-image src="https://dam.ti.com/asset/1cb856ed-21d7-469e-a38f-3d353bafaf68/document-icon-svg.svg" alt="" ratio="rectangle"></ti-image></div><div class="text-label font-normal uppercase empty:hidden text-pl-text-color-primary mb-2">Functional safety information</div><h3 class="mb-4 text-pl-text-color-primary text-h4"><a class="text-inherit" href="https://www.ti.com/lit/ssiy007">Streamlining Functional Safety Certification in Automotive and Industrial</a></h3><div class="mb-4 grow text-body-md empty:mb-0"><div>This white paper explains how TI’s approach to designing integrated circuits (ICs) provides you with the resources needed to streamline your functional safety design.</div></div><div class="relative self-start text-body-md"><div class="flex gap-2"><a href="https://www.ti.com/lit/ssiy007" class="tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">PDF</span></a></div></div></div></ti-card></div><div class="group relative h-full trackingLiteratureCard"><ti-card appearance="plain-white"><div class="flex h-full flex-col"><div class="empty:hidden [&amp;_img]:aspect-video -mx-6 -mt-6 mb-6 [&amp;_img]:block [&amp;_img]:object-cover"><ti-image src="https://dam.ti.com/asset/1cb856ed-21d7-469e-a38f-3d353bafaf68/document-icon-svg.svg" alt="" ratio="rectangle"></ti-image></div><div class="text-label font-normal uppercase empty:hidden text-pl-text-color-primary mb-2">Application brief</div><h3 class="mb-4 text-pl-text-color-primary text-h4"><a class="text-inherit" href="https://www.ti.com/document-viewer/lit/html/slvaf53">High Voltage – Fast Power Fault Detection by Monitoring 24V AC Systems Using TPS</a></h3><div class="mb-4 grow text-body-md empty:mb-0"><div>Fast power-fault detection by monitoring 24V AC systems using TPS37x voltage supervisor.</div></div><div class="relative self-start text-body-md"><div class="flex gap-2"><a href="https://www.ti.com/lit/slvaf53" class="tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">PDF</span></a><span class="text-pl-text-color-disabled">|</span><a href="https://www.ti.com/document-viewer/lit/html/slvaf53" class="tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">HTML</span></a></div></div></div></ti-card></div></div><div class="grid gap-4 md:gap-x-14 md:gap-y-10 md:grid-cols-3 trackingMixedCardList"></div></ti-tab-panel></ti-tab-container></div></div></div></div></div></div></div></div></div></div><div style="width:100%;display:block"><div id="technical-resources" class="trackingSection general-section"><div class="w-full"><div class="relative w-full theme-root theme-white BrandAndThemeContext-module__XLl7IW__themeRoot text-text-default"><div data-component="generic-wrappers/section-wrapper" class="relative flex flex-col items-start self-stretch w-full container-lg box-border! mx-auto space-10 pt-8 md:pt-12 pb-8 md:pb-12"><div class="w-full flex flex-col space-y-4"><div class="container"><div class="flex flex-column bg-{var(--component-section-color-bg)}"><div data-component="generic-wrappers/preamble-section-wrapper" class="flex flex-col w-full gap-8"><div data-preamble-width-cap="true" class="flex w-full flex-col gap-8 md:max-w-2/3"><div class="trackingHeadline flex flex-col"><div class=""><h2 class="text-inherit! mb-0">Technical resources</h2></div></div></div><div class="space-y-4 py-4"><div class="grid gap-4 md:gap-x-14 md:gap-y-10 md:grid-cols-3 trackingMixedCardList"><div class="group relative h-full trackingLiteratureCard"><ti-card appearance="plain-white"><div class="flex h-full flex-col"><div class="text-label font-normal uppercase empty:hidden text-pl-text-color-primary mb-2">E-book</div><h3 class="mb-4 text-pl-text-color-primary text-h4"><a class="text-inherit" href="https://www.ti.com/lit/slyy167">Voltage Supervisor and Reset ICs: Tips, Tricks and Basics</a></h3><div class="mb-4 grow text-body-md empty:mb-0"><div>This article provides an introduction to voltage supervisors and an in-depth overview of their various applications.</div></div><div class="relative self-start text-body-md"><div class="flex gap-2"><a href="https://www.ti.com/lit/slyy167" class="tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">PDF</span></a></div></div></div></ti-card></div><div class="group relative h-full trackingLiteratureCard"><ti-card appearance="plain-white"><div class="flex h-full flex-col"><div class="text-label font-normal uppercase empty:hidden text-pl-text-color-primary mb-2">Selection guide</div><h3 class="mb-4 text-pl-text-color-primary text-h4"><a class="text-inherit" href="https://www.ti.com/lit/slyt361">Voltage Supervisors (Reset ICs) Quick Reference Guide (Rev. H)</a></h3><div class="mb-4 grow text-body-md empty:mb-0"><div>Check out our most popular supervisors and reset ICs.</div></div><div class="relative self-start text-body-md"><div class="flex gap-2"><a href="https://www.ti.com/lit/slyt361" class="tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">PDF</span></a></div></div></div></ti-card></div><div class="group relative h-full trackingLiteratureCard"><ti-card appearance="plain-white"><div class="flex h-full flex-col"><div class="text-label font-normal uppercase empty:hidden text-pl-text-color-primary mb-2">Application note</div><h3 class="mb-4 text-pl-text-color-primary text-h4"><a class="text-inherit" href="https://www.ti.com/lit/slvae47">Voltage Supervisors  (Reset ICs): Frequently Asked Questions (FAQs) (Rev. A)</a></h3><div class="mb-4 grow text-body-md empty:mb-0"><div>Read the FAQs for voltage supervisors, reset ICs, voltage detectors, watchdog timers and related monitoring devices.</div></div><div class="relative self-start text-body-md"><div class="flex gap-2"><a href="https://www.ti.com/lit/slvae47" class="tiCtaLink iconText text-sm" data-cta-link="true"><span class="iconText-text">PDF</span></a></div></div></div></ti-card></div></div></div></div></div></div></div></div></div></div></div></div><div style="width:100%;display:block"><div id="featured-applications" class="trackingSection general-section"><div class="w-full"><div class="relative w-full theme-root theme-grey BrandAndThemeContext-module__XLl7IW__themeRoot text-text-default"><div data-component="generic-wrappers/section-wrapper" class="relative flex flex-col items-start self-stretch w-full container-lg box-border! mx-auto space-10 pt-8 md:pt-12 pb-8 md:pb-12"><div class="w-full flex flex-col space-y-4"><div class="container"><div class="flex flex-column bg-{var(--component-section-color-bg)}"><div data-component="generic-wrappers/preamble-section-wrapper" class="flex flex-col w-full gap-8"><div data-preamble-width-cap="true" class="flex w-full flex-col gap-8 md:max-w-2/3"><div class="trackingHeadline flex flex-col"><div class=""><h2 class="text-inherit! mb-0">Discover featured applications</h2></div></div></div><div class="space-y-4 py-4"><ti-carousel class="trackingModalCardList" gap="large" navigation="inline"><div class="box-content! empty:hidden"><ti-card class="trackingModalResourceCard" appearance="plain-dark" data-lid="applications-tab-container-Factory automation &amp; control"><button slot="card-link" type="button" data-navtitle="learn-more">Factory automation &amp; control</button><div class="flex h-full flex-col"><div class="-mx-6 -mt-6 mb-6 aspect-video overflow-hidden"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/3df7cc69-baa8-4b71-ae92-0039cc4f1584/Human-machine-interface-automation-factory"/></div><div class="mb-4 text-label text-pl-text-color-primary-contrast uppercase">Factory automation &amp; control</div><div class="text-body-lg text-pl-text-color-primary-contrast">Ensure system reliability in factory automation by adding a flexible supply-voltage supervisor with an integrated watchdog timer</div></div></ti-card><ti-dialog modal="" size="large" mobile-edgetoedge=""><h3 slot="title">Ensure system reliability in factory automation by adding a flexible supply-voltage supervisor with an integrated watchdog timer</h3><div class="-mx-4 -mt-4 mb-6 bg-pl-container-background-color-secondary px-4 pt-4 pb-6 md:-mx-8 md:-mt-8 md:mb-8 md:p-8"><div class="grid gap-6 md:grid-cols-2 md:gap-x-14"><div class="order-1 md:order-2"><div class="aspect-video w-full overflow-hidden border border-solid border-pl-border-color-primary"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/3df7cc69-baa8-4b71-ae92-0039cc4f1584/Human-machine-interface-automation-factory"/></div></div><div class="order-2 md:order-1"><div class="text-body-lg [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ms-5 [&amp;_ol]:ms-5 [&amp;&gt;*:last-child]:mb-0"><p>For programmable logic controller field transmitters or industrial PC designs, microcontroller power rails need voltage monitoring to ensure power within regulation specifications, ensuring system safety.</p><p>Benefits:<br/></p><ul><li>Programmable sense-and-reset delay for high-voltage rails</li><li>Manual reset capability to force system resets</li><li>Separate VDD and SENSE pins add redundancy to high-reliability systems</li><li>Functional safety ratings up to Safety Integrity Level (SIL) 3 and SIL 4</li></ul></div></div></div></div><h4 class="mb-6 text-h5 text-pl-text-color-primary">Featured resources</h4><div class="columns-1 gap-x-8 md:columns-2"><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">END-EQUIPMENT / SUB-SYSTEM</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/cpu-plc-controller?variantid=14289&amp;subsystemid=20019" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Central processing unit (PLC controller) - self-diagnostics/monitoring</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/analog-input-module?variantid=14332&amp;subsystemid=18167" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Analog input module - point-of-load regulator</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/analog-output-module#block-diagram?variantid=14280&amp;subsystemid=15846" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Analog output module - Voltage-current output module – isolated</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/pressure-transmitter?variantid=14412&amp;subsystemid=16853" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Pressure transmitter - Nonisolated DC/DC power supply (point of load)</a></li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">REFERENCE DESIGNS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-010049" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-010049</a> – TUV-assessed digital input reference design for IEC 61508 (SIL-2)</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDEP0020" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDEP0020</a> – AM437x Discrete Power Reference Design</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDEP0050" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDEP0050</a> – EnDat 2.2 System Reference Design</li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">PRODUCTS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS37" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS37</a> – 65-V window supervisor with ultra-low quiescent current and time-delay function</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3704" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3704</a> – Multichannel window supervisor with high accuracy and compact form factor</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3435" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3435</a> – Nano-quiescent-current precision timeout watchdog timer</li></ul></div></div></ti-dialog></div><div class="box-content! empty:hidden"><ti-card class="trackingModalResourceCard" appearance="plain-dark" data-lid="applications-tab-container-ADAS"><button slot="card-link" type="button" data-navtitle="learn-more">ADAS</button><div class="flex h-full flex-col"><div class="-mx-6 -mt-6 mb-6 aspect-video overflow-hidden"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/165f8daa-2169-45c1-a752-d3f58a763a4b/Automotive-rear-camera"/></div><div class="mb-4 text-label text-pl-text-color-primary-contrast uppercase">ADAS</div><div class="text-body-lg text-pl-text-color-primary-contrast">Enable functional safety for ADAS applications with our precision multichannel voltage supervisors</div></div></ti-card><ti-dialog modal="" size="large" mobile-edgetoedge=""><h3 slot="title">Enable functional safety for ADAS applications with our precision multichannel voltage supervisors</h3><div class="-mx-4 -mt-4 mb-6 bg-pl-container-background-color-secondary px-4 pt-4 pb-6 md:-mx-8 md:-mt-8 md:mb-8 md:p-8"><div class="grid gap-6 md:grid-cols-2 md:gap-x-14"><div class="order-1 md:order-2"><div class="aspect-video w-full overflow-hidden border border-solid border-pl-border-color-primary"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/165f8daa-2169-45c1-a752-d3f58a763a4b/Automotive-rear-camera"/></div></div><div class="order-2 md:order-1"><div class="text-body-lg [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ms-5 [&amp;_ol]:ms-5 [&amp;&gt;*:last-child]:mb-0"><p>In integrated ADAS, monitoring power rails for processors and microcontrollers (MCU) helps prevent brownout from irregular voltage-output conditions. Our portfolio of low-power supervisors help ensure system safety by alerting the MCU during an over- or undervoltage event.</p><p>Benefits:<br/></p><ul><li>Multichannel monitoring allows for precise power control on complex designs</li><li>Window detection for systems requiring over- and undervoltage monitoring</li><li>Watchdog feature prevents processing glitches and ensures continuous device functionality</li><li>Support for functional safety requirements up to ASIL D</li></ul></div></div></div></div><h4 class="mb-6 text-h5 text-pl-text-color-primary">Featured resources</h4><div class="columns-1 gap-x-8 md:columns-2"><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">END-EQUIPMENT / SUB-SYSTEM</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/automotive-front-camera?variantid=17142&amp;subsystemid=17181" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Front camera - processor power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/surround-view-system-ecu?variantid=18217&amp;subsystemid=18693" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Surround-view system electronic control unit - processor power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/adas-domain-controller?variantid=34354&amp;subsystemid=20614" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">ADAS domain controller - processor power supply</a></li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">REFERENCE DESIGNS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-050008" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-050008</a> – ADAS power reference design with improved voltage supervision</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-00530" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-00530</a> – Automotive Power Reference Design for Low Power TDA3x Based Systems</li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">PRODUCTS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3704-Q1" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3704-Q1</a> – Automotive multichannel window supervisor with high accuracy and compact form factor</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS38700-Q1" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS38700-Q1</a> – Automotive power-supply sequencer with I²C support for up to 12 channels</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS389006-Q1" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS389006-Q1</a> – Automotive multichannel overvoltage and undervoltage I²C programmable voltage supervisor and monitor</li></ul></div></div></ti-dialog></div><div class="box-content! empty:hidden"><ti-card class="trackingModalResourceCard" appearance="plain-dark" data-lid="applications-tab-container-Motor Drives"><button slot="card-link" type="button" data-navtitle="learn-more">Motor Drives</button><div class="flex h-full flex-col"><div class="-mx-6 -mt-6 mb-6 aspect-video overflow-hidden"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/0f543f5e-1555-47a7-9c47-b4a19cd020e4/RESTRICTED-USE-Motor-drivers-robot-arm-working-in-car-factory"/></div><div class="mb-4 text-label text-pl-text-color-primary-contrast uppercase">Motor Drives</div><div class="text-body-lg text-pl-text-color-primary-contrast">Design reliable motor drives with wide-VIN multichannel supervisors</div></div></ti-card><ti-dialog modal="" size="large" mobile-edgetoedge=""><h3 slot="title">Design reliable motor drives with wide-VIN multichannel supervisors</h3><div class="-mx-4 -mt-4 mb-6 bg-pl-container-background-color-secondary px-4 pt-4 pb-6 md:-mx-8 md:-mt-8 md:mb-8 md:p-8"><div class="grid gap-6 md:grid-cols-2 md:gap-x-14"><div class="order-1 md:order-2"><div class="aspect-video w-full overflow-hidden border border-solid border-pl-border-color-primary"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/0f543f5e-1555-47a7-9c47-b4a19cd020e4/RESTRICTED-USE-Motor-drivers-robot-arm-working-in-car-factory"/></div></div><div class="order-2 md:order-1"><div class="text-body-lg [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ms-5 [&amp;_ol]:ms-5 [&amp;&gt;*:last-child]:mb-0"><p>Motor drives require proper regulation for their power supplies as well as precise sensing for accurate position and torque control. Use our low-current voltage supervisors to monitor core voltage rails and reliable operation without draining power.</p><p>Benefits: <br/></p><ul><li>VIN options up to 65 V with the TPS37 and TPS38</li><li>Multichannel monitoring available</li><li>Adjustable and fixed-sense inputs for high-voltage rails</li><li>Programmable time delay for sequencing flexibility</li></ul></div></div></div></div><h4 class="mb-6 text-h5 text-pl-text-color-primary">Featured resources</h4><div class="columns-1 gap-x-8 md:columns-2"><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">END-EQUIPMENT / SUB-SYSTEM</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/servo-drive-control-module?variantid=34451&amp;subsystemid=29800" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Servo drive control module - nonisolated DC/DC power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/servo-drive-control-panel?variantid=35062&amp;subsystemid=29343" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Servo drive control panel - nonisolated DC/DC power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/surround-view-system-ecu?variantid=18217&amp;subsystemid=18693" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Surround-view system electronic control unit - processor power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/servo-drive-functional-safety-module#block-diagram?variantid=35239&amp;subsystemid=31221" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Motor drives - servo drive functional safety module</a></li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">REFERENCE DESIGNS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDEP0020" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDEP0020</a> – AM437x Discrete Power Reference Design</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDM-SERVODRIVE" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDM-SERVODRIVE</a> – Industrial Servo Drive and AC Inverter Drive Reference Design</li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">PRODUCTS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS37" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS37</a> – 65-V window supervisor with ultra-low quiescent current and time-delay function</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3704" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3704</a> – Multichannel window supervisor with high accuracy and compact form factor</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3899" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3899</a> – Nanopower supervisor with programmable sense and reset delay</li></ul></div></div></ti-dialog></div><div class="box-content! empty:hidden"><ti-card class="trackingModalResourceCard" appearance="plain-dark" data-lid="applications-tab-container-Energy Storage Systems"><button slot="card-link" type="button" data-navtitle="learn-more">Energy Storage Systems</button><div class="flex h-full flex-col"><div class="-mx-6 -mt-6 mb-6 aspect-video overflow-hidden"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/ae49dba9-967d-4cc9-8b05-8b4963ae047a/Electrical-grid-storage"/></div><div class="mb-4 text-label text-pl-text-color-primary-contrast uppercase">Energy Storage Systems</div><div class="text-body-lg text-pl-text-color-primary-contrast">Optimize energy storage system designs using voltage supervisors and watchdog timers</div></div></ti-card><ti-dialog modal="" size="large" mobile-edgetoedge=""><h3 slot="title">Optimize energy storage system designs using voltage supervisors and watchdog timers</h3><div class="-mx-4 -mt-4 mb-6 bg-pl-container-background-color-secondary px-4 pt-4 pb-6 md:-mx-8 md:-mt-8 md:mb-8 md:p-8"><div class="grid gap-6 md:grid-cols-2 md:gap-x-14"><div class="order-1 md:order-2"><div class="aspect-video w-full overflow-hidden border border-solid border-pl-border-color-primary"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/ae49dba9-967d-4cc9-8b05-8b4963ae047a/Electrical-grid-storage"/></div></div><div class="order-2 md:order-1"><div class="text-body-lg [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ms-5 [&amp;_ol]:ms-5 [&amp;&gt;*:last-child]:mb-0"><p>Energy storage systems rely on voltage supervisors to monitor power rails and assert reset signals when necessary. Our voltage supervisors include low quiescent current (IQ), high precision and exceptional programmability.</p><p>Benefits:<br/></p><ul><li>Watchdog timers increase system reliability in the event of an microcontroller malfunction</li><li>Window voltage monitoring for systems requiring over- and undervoltage monitoring</li><li>Minimize power consumption by maintaining ultra-low IQ on up to four channels</li></ul></div></div></div></div><h4 class="mb-6 text-h5 text-pl-text-color-primary">Featured resources</h4><div class="columns-1 gap-x-8 md:columns-2"><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">END-EQUIPMENT / SUB-SYSTEM</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/energy-storage-battery-packs-with-bms?variantid=26401" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Battery energy storage system - single-module battery</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/energy-storage-power-conversion-system" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Energy storage systems - power conversion system</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/portable-power-station?variantid=237090&amp;subsystemid=238135" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Portable power station - power factor correction inverter control unit</a></li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">REFERENCE DESIGNS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-01214" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-01214</a> – Isolated, High-Accuracy Analog Input Module Reference Design Using 16-Bit ADC and Digital Isolator</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-010041" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-010041</a> – Nano power, wide VIN (12 V max) supervisor reference design used as comparator or power sequencer</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-010052" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-010052</a> – Safety power supply for motor drives reference design</li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">PRODUCTS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3704" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3704</a> – Multichannel window supervisor with high accuracy and compact form factor</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3435" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3435</a> – Nano-quiescent-current precision timeout watchdog timer</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3899" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3899</a> – Nanopower supervisor with programmable sense and reset delay</li></ul></div></div></ti-dialog></div><div class="box-content! empty:hidden"><ti-card class="trackingModalResourceCard" appearance="plain-dark" data-lid="applications-tab-container-Hybrid, electric &amp; powertrain systems"><button slot="card-link" type="button" data-navtitle="learn-more">Hybrid, electric &amp; powertrain systems</button><div class="flex h-full flex-col"><div class="-mx-6 -mt-6 mb-6 aspect-video overflow-hidden"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/8975f6ae-850e-4911-931d-b4898d28e9be/Driver-assist-red-auto-night-scene"/></div><div class="mb-4 text-label text-pl-text-color-primary-contrast uppercase">Hybrid, electric &amp; powertrain systems</div><div class="text-body-lg text-pl-text-color-primary-contrast">Enhance system stability in EVs and comply with functional safety requirements using flexible, high-precision voltage supervisors</div></div></ti-card><ti-dialog modal="" size="large" mobile-edgetoedge=""><h3 slot="title">Enhance system stability in EVs and comply with functional safety requirements using flexible, high-precision voltage supervisors</h3><div class="-mx-4 -mt-4 mb-6 bg-pl-container-background-color-secondary px-4 pt-4 pb-6 md:-mx-8 md:-mt-8 md:mb-8 md:p-8"><div class="grid gap-6 md:grid-cols-2 md:gap-x-14"><div class="order-1 md:order-2"><div class="aspect-video w-full overflow-hidden border border-solid border-pl-border-color-primary"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/8975f6ae-850e-4911-931d-b4898d28e9be/Driver-assist-red-auto-night-scene"/></div></div><div class="order-2 md:order-1"><div class="text-body-lg [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ms-5 [&amp;_ol]:ms-5 [&amp;&gt;*:last-child]:mb-0"><p>Voltage supervisors are imperative when monitoring system health in high-reliability automotive systems where functional safety is paramount. Our voltage supervisors include low quiescent current (IQ), high precision and high programmability.</p><p>Benefits:<br/></p><ul><li>Window voltage monitoring for systems requiring over- and undervoltage monitoring</li><li>Minimize power consumption by maintaining ultra-low IQ on up to four channels</li><li>Programmable reset delays and window watchdog timing options enable customization</li><li>Support for functional safety requirements up to Automotive Safety Integrity Level (ASIL) D</li></ul></div></div></div></div><h4 class="mb-6 text-h5 text-pl-text-color-primary">Featured resources</h4><div class="columns-1 gap-x-8 md:columns-2"><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">END-EQUIPMENT / SUB-SYSTEM</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/48-v-to-12-v-dc-dc-converter?variantid=18502&amp;subsystemid=19140" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">48-V to 12-V DC/DC converter - voltage reference</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/400-v-battery-pack-passive-balancing" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Hybrid electric vehicle (HEV)/EV battery-management system - 400-V battery pack – passive balancing</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/traction-inverter-high-voltage?variantid=14291&amp;subsystemid=17097#block-diagram" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Traction inverter – high voltage - digital processing</a></li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">REFERENCE DESIGNS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-01168" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-01168</a> – Bidirectional DC/DC Converter Reference Design for 12-V/48-V Automotive Systems</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-020014" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-020014</a> – HEV/EV traction inverter power stage with 3 types of IGBT/SiC bias-supply solutions reference design</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/PMP22650" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">PMP22650</a> – GaN-based, 6.6-kW, bidirectional, onboard charger reference design</li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">PRODUCTS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3850-Q1" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3850-Q1</a> – Automotive, window supervisor for OV &amp; UV monitoring with window watchdog timer &amp; programmable delay</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS3704-Q1" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS3704-Q1</a> – Automotive multichannel window supervisor with high accuracy and compact form factor</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/product/TPS37-Q1" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TPS37-Q1</a> – Automotive 65-V window supervisor with ultra-low quiescent current and time-delay function</li></ul></div></div></ti-dialog></div><div class="box-content! empty:hidden"><ti-card class="trackingModalResourceCard" appearance="plain-dark" data-lid="applications-tab-container-Body Electronics and Lighting"><button slot="card-link" type="button" data-navtitle="learn-more">Body Electronics and Lighting</button><div class="flex h-full flex-col"><div class="-mx-6 -mt-6 mb-6 aspect-video overflow-hidden"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/5cfc8926-e440-4b87-93a3-eded40d766b9/Body-electronics-and-lighting-car-interior-dashboard"/></div><div class="mb-4 text-label text-pl-text-color-primary-contrast uppercase">Body Electronics and Lighting</div><div class="text-body-lg text-pl-text-color-primary-contrast">Advance power efficiency for body control modules with compact, wide-VIN supervisors</div></div></ti-card><ti-dialog modal="" size="large" mobile-edgetoedge=""><h3 slot="title">Advance power efficiency for body control modules with compact, wide-VIN supervisors</h3><div class="-mx-4 -mt-4 mb-6 bg-pl-container-background-color-secondary px-4 pt-4 pb-6 md:-mx-8 md:-mt-8 md:mb-8 md:p-8"><div class="grid gap-6 md:grid-cols-2 md:gap-x-14"><div class="order-1 md:order-2"><div class="aspect-video w-full overflow-hidden border border-solid border-pl-border-color-primary"><img data-component="helpers/atoms/enhanced-next-image" alt="" loading="lazy" width="1280" height="720" decoding="async" data-nimg="1" class="h-full w-full object-contain" style="color:transparent" src="https://dam.ti.com/transform/5cfc8926-e440-4b87-93a3-eded40d766b9/Body-electronics-and-lighting-car-interior-dashboard"/></div></div><div class="order-2 md:order-1"><div class="text-body-lg [&amp;_p]:mb-6 [&amp;_ul]:mb-6 [&amp;_ol]:mb-6 [&amp;_ul]:ms-5 [&amp;_ol]:ms-5 [&amp;&gt;*:last-child]:mb-0"><p>In body control modules and automotive gateways, reset integrated circuits (ICs) ensure power efficiency and early detection for irregular voltage output conditions. Our supervisors help meet your system needs at some of the industry&#x27;s fastest detection speeds.</p><p> </p><p>Benefits:</p><ul><li>VIN options up to 65 V with the TPS37-Q1</li><li>Window voltage monitoring for systems requiring over- and undervoltage monitoring</li><li>Programmable reset and sense delay timing for more configurability</li><li>Separate VDD and sense pins enable the monitoring of voltages higher and lower than VDD</li></ul></div></div></div></div><h4 class="mb-6 text-h5 text-pl-text-color-primary">Featured resources</h4><div class="columns-1 gap-x-8 md:columns-2"><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">END-EQUIPMENT / SUB-SYSTEM</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/body-control-module-bcm?variantid=14361&amp;subsystemid=15077" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Body control module (BCM) - power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/power-distribution-box?variantid=26112&amp;subsystemid=27125#block-diagram" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Power distribution box - power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/automotive-gateway?variantid=191493&amp;subsystemid=191498#block-diagram" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Automotive gateway - power supply</a></li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="/solution/zonal-module?variantid=235166&amp;subsystemid=263447" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">Zonal module - power supply</a></li></ul></div><div class="mb-8 break-inside-avoid"><div class="mb-2 text-label text-pl-text-color-primary uppercase">REFERENCE DESIGNS</div><ul class="m-0 list-none p-0"><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-01168" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-01168</a> – Bidirectional DC/DC Converter Reference Design for 12-V/48-V Automotive Systems</li><li class="border-0 border-b border-solid border-pl-divider-color-secondary pt-[7px] pb-2 text-body-md"><a href="https://www.ti.com/tool/TIDA-00699" data-navtitle="learn-more" class="text-pl-link-color-primary no-underline hover:underline">TIDA-00699</a> – Front End Power S